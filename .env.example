# ============================================
# CENTRAL VENDAS — CONFIGURAÇÃO
# Copie para .env e preencha os valores
# ============================================

# --- IA (OBRIGATÓRIO) ---
ANTHROPIC_API_KEY=sk-ant-...      # Claude Sonnet — Gestor Jarvis
GEMINI_API_KEY=AIza...            # Gemini Flash — Agentes de vendas (grátis)

# --- Senha do Dashboard ---
DASHBOARD_PASSWORD=sua-senha-aqui

# --- Agente Info-Produtos ---
INFO_NUMERO=55...                 # Número WhatsApp do agente (com DDI)
INFO_PROVIDER=baileys             # baileys ou zapi
INFO_ZAPI_INSTANCE=
INFO_ZAPI_TOKEN=
INFO_ZAPI_CLIENT_TOKEN=
INFO_FOTO1=                       # URL da imagem do produto
INFO_VIDEO1=                      # URL do vídeo de apresentação

# --- Agente Logzz ---
LOGZZ_NUMERO=55...                # Número WhatsApp do agente
LOGZZ_PROVIDER=baileys
LOGZZ_ZAPI_INSTANCE=
LOGZZ_ZAPI_TOKEN=
LOGZZ_ZAPI_CLIENT_TOKEN=
LOGZZ_FOTO1=
LOGZZ_VIDEO1=
LOGZZ_TOKEN=                      # Token da API Logzz (rastreamento)

# --- Gestor Jarvis ---
TELEGRAM_BOT_TOKEN=               # Token do bot Telegram (@BotFather)
TELEGRAM_CHAT_ID=                 # Chat ID do Miron (seu ID pessoal)
GITHUB_TOKEN=ghp_...              # Token GitHub para auto-deploy
GITHUB_REPO=mironrodriguescostaneto-cell/central-vendas
RAILWAY_API_KEY=                  # API Key do Railway (opcional, para redeploy)

# --- Servidor ---
PORT=3000

# --- Redis (opcional — se não tiver, usa JSON local) ---
REDIS_URL=redis://...
